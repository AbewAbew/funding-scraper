# Copy to .env for local runs. In GitHub Actions these are repository Secrets.

# AI providers: at least one. They're tried in this order and fall back automatically.
GOOGLE_API_KEY=        # https://aistudio.google.com/apikey  (Gemma 4, free)
GROQ_API_KEY=          # https://console.groq.com/keys      (free, optional fallback)
# OPENROUTER_API_KEY=  # optional second fallback

# Supabase (Settings -> API Keys -> "Publishable and secret API keys").
# The pipeline needs the SECRET key (sb_secret_...). Never commit it or use it in a browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_KEY=   # legacy service_role key, still accepted as a fallback until end of 2026

# Optional overrides (defaults in config.py)
# GEMINI_MODEL=gemma-4-31b-it
# GROQ_MODEL=openai/gpt-oss-120b
# MAX_AI_CALLS_PER_RUN=400
# ARTICLE_CUTOFF_MONTHS=6
# DROP_INDIVIDUAL_ONLY=false
